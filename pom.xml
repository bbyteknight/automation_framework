<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>rpa</groupId>
    <artifactId>AutomationFramework</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>AutomationFramework</name>
    <url>http://maven.apache.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <selenium.version>4.32.0</selenium.version>
        <testng.version>7.9.0</testng.version>
        <gson.version>2.10.1</gson.version>
        <poi-ooxml.version>5.4.0</poi-ooxml.version>
        <slf4j.version>2.0.9</slf4j.version>
        <commons-io.version>2.18.0</commons-io.version>
        <webdrivermanager.version>6.1.0</webdrivermanager.version>
        <appium-java-client.version>9.3.0</appium-java-client.version>
        <rest-assured.version>5.5.0</rest-assured.version>
        <jackson.version>2.18.0</jackson.version>
        <lombok.version>1.18.38</lombok.version>
        <assertj.version>3.26.3</assertj.version>
        <datafaker.version>2.3.1</datafaker.version>
        <commons-csv.version>1.11.0</commons-csv.version>
        <maven-surefire-plugin.version>3.5.1</maven-surefire-plugin.version>
        <dotenv-java.version>3.0.2</dotenv-java.version>
        <log4j2.version>2.24.1</log4j2.version>
        <parallel.mode>methods</parallel.mode>
        <thread.count>4</thread.count>
        <!-- Points at the FILTERED copy (see testResources below), not src/testng.xml directly,
             so parallel.mode/thread.count placeholders inside it get resolved from these
             properties — and therefore from -D overrides — before Surefire reads it. -->
        <suite.file>target/test-classes/testng.xml</suite.file>
        <!-- Default matches the previous @CucumberOptions(tags = "@web") annotation default on
             CucumberTestRunner, so a bare `mvn test` behaves exactly as before. Overridden by the
             smoke/regression/api/web/mobile profiles below, or directly via
             -Dcucumber.filter.tags="..." (takes precedence over any active profile). -->
        <cucumber.filter.tags>@web</cucumber.filter.tags>
        <cucumber.version>7.20.1</cucumber.version>
        <cucumber-reporting.version>5.8.1</cucumber-reporting.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <allure.version>2.35.5</allure.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <sonar-maven-plugin.version>4.0.0.4121</sonar-maven-plugin.version>
        <!-- SonarCloud project coordinates (free for public repos). These match
             SonarCloud's default naming when importing a GitHub repo as a new
             project — confirm they're correct once the project exists there,
             and set the SONAR_TOKEN repo secret; see README.md "Code quality". -->
        <sonar.projectKey>bbyteknight_automation_framework</sonar.projectKey>
        <sonar.organization>bbyteknight</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi-ooxml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${appium-java-client.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv-java.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <version>${allure.version}</version>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <!-- Default test resources, unfiltered (feature files, JSON test data, config
                 properties) — re-declared explicitly because adding any <testResources> below
                 replaces Maven's implicit default rather than adding to it. -->
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>false</filtering>
            </testResource>
            <!-- Copies testng.xml/testng-rerun.xml into target/test-classes with their
                 ${parallel.mode}/${thread.count} placeholders resolved, so -Dparallel.mode/
                 -Dthread.count actually take effect (TestNG reads its own suite XML's
                 parallel/thread-count attributes verbatim, ignoring Surefire's <parallel>/
                 <threadCount> config, whenever a suiteXmlFile is supplied). -->
            <testResource>
                <directory>src</directory>
                <includes>
                    <include>testng.xml</include>
                    <include>testng-rerun.xml</include>
                </includes>
                <filtering>true</filtering>
                <targetPath>.</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Code-review rule: fails the build on any Thread.sleep() call. Bound to
                 validate so it runs on every mvn compile/test/install, not just an
                 explicit goal. See checkstyle.xml at the project root. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <failsOnError>true</failsOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>ban-thread-sleep</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suite.file}</suiteXmlFile>
                    </suiteXmlFiles>
                    <parallel>${parallel.mode}</parallel>
                    <threadCount>${thread.count}</threadCount>
                    <!-- Let the build continue past a failing first run so the rerun step
                         (scripts/rerun-failed-tests.sh) gets a chance to retry only the
                         failed scenarios. The real pass/fail gate moves to the report-merge
                         step (maven-cucumber-reporting, checkBuildResult) below. -->
                    <testFailureIgnore>true</testFailureIgnore>
                    <!-- Forwards the resolved cucumber.filter.tags Maven property (profile
                         default or -D override) as an actual JVM system property in the forked
                         test JVM, which is what cucumber-testng reads at runtime. -->
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${cucumber.filter.tags}</cucumber.filter.tags>
                    </systemPropertyVariables>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- Not bound to a lifecycle phase — invoked explicitly by
                 scripts/rerun-failed-tests.sh after both runs complete.
                 jsonFiles is a List parameter, so it must be configured here in
                 XML rather than via -D on the CLI (Maven won't bind list params
                 to simple -D properties). The script guarantees run2.json exists
                 (copying run1.json over it when no rerun was needed) so this
                 static file list is always valid. -->
            <plugin>
                <groupId>net.masterthought</groupId>
                <artifactId>maven-cucumber-reporting</artifactId>
                <version>${cucumber-reporting.version}</version>
                <configuration>
                    <projectName>AutomationFramework</projectName>
                    <outputDirectory>${project.build.directory}/cucumber-reports/merged</outputDirectory>
                    <inputDirectory>${project.build.directory}/cucumber-reports</inputDirectory>
                    <jsonFiles>
                        <param>*.json</param>
                    </jsonFiles>
                    <mergeFeaturesById>true</mergeFeaturesById>
                    <mergeFeaturesWithRetest>true</mergeFeaturesWithRetest>
                    <!-- checkBuildResult is intentionally false: in testing it gates on any
                         failure across ALL parsed executions, not the retest-reconciled result,
                         which would fail the build even when the rerun passed. The rerun script
                         determines the real pass/fail by inspecting the final JSON directly. -->
                    <checkBuildResult>false</checkBuildResult>
                </configuration>
            </plugin>
            <!-- The io.qameta.allure:allure-maven plugin manages its own download of the Allure
                 CLI, but that download resolves io.qameta.allure:allure-commandline, which has no
                 2.35.5 release on Maven Central (allure-cucumber7-jvm/allure-testng do) — a real
                 version gap, not a mirror/proxy problem. Shelling out to an Allure CLI already on
                 PATH (e.g. `npm install -g allure-commandline`, or whatever a CI image provides)
                 sidesteps that gap entirely. Not bound to a lifecycle phase — run explicitly via
                 `mvn exec:exec@allure-report` (static HTML into target/allure-report) or
                 `mvn exec:exec@allure-serve` (local preview server) once target/allure-results has
                 been populated by a test run. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>allure-report</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>allure</executable>
                            <arguments>
                                <argument>generate</argument>
                                <argument>${project.build.directory}/allure-results</argument>
                                <argument>--clean</argument>
                                <argument>-o</argument>
                                <argument>${project.build.directory}/allure-report</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>allure-serve</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>allure</executable>
                            <arguments>
                                <argument>serve</argument>
                                <argument>${project.build.directory}/allure-results</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Not bound to a lifecycle phase — run explicitly via `mvn sonar:sonar`
                 (CI does this after `mvn compile` so Sonar can analyze real bytecode,
                 without re-running the test suite a second time). Needs SONAR_TOKEN
                 (repo secret, from sonarcloud.io) to actually submit an analysis. -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <!-- Shortcuts for the platform/suite scopes documented in GHERKIN_GUIDE.md and README.md.
         Each just sets cucumber.filter.tags to the matching expression; -Dcucumber.filter.tags=
         on the command line still overrides whichever profile (or none) is active. -->
    <profiles>
        <profile>
            <id>smoke</id>
            <properties>
                <cucumber.filter.tags>@smoke</cucumber.filter.tags>
            </properties>
        </profile>
        <profile>
            <id>regression</id>
            <properties>
                <cucumber.filter.tags>not @wip</cucumber.filter.tags>
            </properties>
        </profile>
        <profile>
            <id>api</id>
            <properties>
                <cucumber.filter.tags>@api</cucumber.filter.tags>
            </properties>
        </profile>
        <profile>
            <id>web</id>
            <properties>
                <cucumber.filter.tags>@web</cucumber.filter.tags>
            </properties>
        </profile>
        <profile>
            <id>mobile</id>
            <properties>
                <!-- Needs an Appium server + device/emulator; not available on the current
                     CI runner (see ci.yml's platform input). -->
                <cucumber.filter.tags>@android or @ios</cucumber.filter.tags>
            </properties>
        </profile>
        <profile>
            <id>desktop</id>
            <properties>
                <!-- Needs a Windows host + Appium server + NovaWindows driver (see
                     DESKTOP_AUTOMATION_SETUP.md); also pass -Dplatform=windows since
                     the dev/qa/staging properties files default platform=web. Not
                     available on the current CI runner. -->
                <cucumber.filter.tags>@desktop</cucumber.filter.tags>
            </properties>
        </profile>
    </profiles>
</project>
