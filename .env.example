# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.
# In CI/pipelines, set these as real environment variables / secrets instead
# (GitHub Actions secrets, Jenkins credentials, Azure DevOps variable groups, etc.)
# See SECRETS.md for full documentation of each key.

# Active environment: dev | qa | staging
ENV=dev

# Web login credentials (LoginTest / LoginPage)
LOGIN_USERNAME=
LOGIN_PASSWORD=

# API auth (REST Assured clients)
API_TOKEN=
API_CLIENT_ID=
API_CLIENT_SECRET=

# Mobile app credentials / device cloud (Appium)
MOBILE_USERNAME=
MOBILE_PASSWORD=
APPIUM_CLOUD_API_KEY=
