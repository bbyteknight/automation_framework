<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Rerun Suite" parallel="${parallel.mode}" thread-count="${thread.count}">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Cucumber Rerun">
        <classes>
            <class name="runners.RerunTestRunner"/>
        </classes>
    </test>
</suite>
