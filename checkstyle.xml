<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Minimal, targeted ruleset: bans Thread.sleep() across the codebase.
  Explicit waits (BasePage/WaitUtils: waitForVisibility/waitForClickability/
  waitForInvisibility) replace it. Not a general style ruleset — add rules
  here deliberately, not by default.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="RegexpSinglelineJava">
            <property name="format" value="Thread\.sleep\("/>
            <property name="message"
                      value="Thread.sleep() is banned — use an explicit wait (BasePage/WaitUtils) instead of a fixed sleep."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
